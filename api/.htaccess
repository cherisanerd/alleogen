# Deny direct access to shared include files. Only endpoint PHP files
# (inside sub-directories) are meant to be hit by clients.
<FilesMatch "^(config|config\.local|config\.local\.example|helpers|middleware|mailer|router|client|scraper|generator)\.php$">
    Require all denied
</FilesMatch>

# Block access to composer and git metadata if they happen to land here.
<FilesMatch "^(composer\.(json|lock)|\.env.*)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /tools/alleogen/api/

    # Prevent serving config.local.php under ANY circumstance, even if
    # FilesMatch above is bypassed by an unusual server config.
    RewriteRule ^config\.local\.php$ - [F,L]

    # Extensionless URLs — the React client calls /api/auth/me etc.
    # If the literal path doesn't exist as a file or directory, look
    # for <path>.php and serve that. Lets /api/auth/me resolve to
    # api/auth/me.php without changing any client code.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Default content type for JSON endpoints when PHP doesn't set one
# (shouldn't happen, but belt-and-suspenders).
DirectoryIndex index.php
