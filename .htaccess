# AEO File Generator — SPA routing under cherisanerd.com/tools/alleogen/
#
# Vite builds with base='/tools/alleogen/'. This .htaccess ships with
# the built site so that:
#   - /api/*         → passes through to api/*.php untouched
#   - /storage/*     → denied (handled by storage/.htaccess)
#   - static assets  → served as-is
#   - everything else → rewritten to index.html so React Router owns it

# Always serve the SPA entry point for directory requests, and never
# let Apache show a directory listing even if our rewrite somehow misses.
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /tools/alleogen/

    # Stop immediately if the request IS the SPA entry point.
    # Without this, the fallback rewrite below loops forever on some
    # Apache/LiteSpeed configs (Bluehost included).
    RewriteRule ^index\.html$ - [L]

    # API passes through.
    RewriteRule ^api/ - [L]

    # Block direct access to the storage directory at the URL level
    # (defense-in-depth; storage/.htaccess already denies it).
    RewriteRule ^storage/ - [F,L]

    # If the request is an existing file or directory, serve it.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Static-asset extensions that are missing should 404 cleanly,
    # not fall through to index.html. This prevents the confusing
    # "MIME type text/html for JS module" error that happens when a
    # stale bundle hash is referenced.
    RewriteRule \.(js|mjs|css|map|ico|png|jpe?g|gif|svg|webp|woff2?|ttf|eot|otf|json|xml|txt)$ - [L,R=404]

    # Otherwise, fall through to the SPA entry point. Absolute path
    # (not bare 'index.html') so the rewrite target is unambiguous
    # under any RewriteBase / subrequest combination.
    RewriteRule . /tools/alleogen/index.html [L]
</IfModule>

# Cache static assets aggressively; they have hashed filenames from Vite.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# Never cache the SPA entry point.
<FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Security headers. Tune CSP once the app is live and the exact
# script/style origins are known.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
